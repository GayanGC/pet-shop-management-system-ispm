{
  "name": "pet-shop-management-system",
  "version": "1.0.0",
  "description": "4 Paw Animal Clinic - Pet Shop Management System",
  "main": "index.js",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GayanGC/pet-shop-management-system-ispm.git"
  },
  "author": "",
  "license": "ISC"
}
